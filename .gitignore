!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# database (SQLite local — se crea y auto-siembra al primer arranque)
/db/
*.db
*.db-journal

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (configura tus propias variables)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# infra local del sandbox (no forma parte de la app)
/.zscripts/
/Caddyfile
/mini-services/
/examples/
/download/
/upload/
/worklog.md
/dev.log

