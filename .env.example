# Copia este archivo a .env y completa los valores

# PostgreSQL (Neon) — cadena de conexión del proyecto
# Runtime serverless (Vercel): usa el host "-pooler" con
#   ?sslmode=require&pgbouncer=true&connection_limit=1
# Migraciones (`prisma db push`): usa el host directo (sin pgbouncer)
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx-pooler.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Secreto HMAC para firmar sesiones (openssl rand -hex 32)
AUTH_SECRET=""
